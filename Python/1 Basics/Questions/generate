# Function to add a differentiation table to the Word document
def add_differentiation(title, headers, rows):
    doc.add_heading(title, level=2)
    
    # Create a table with the specified number of columns (headers)
    table = doc.add_table(rows=1, cols=len(headers))
    
    # Add the headers to the first row
    for i, header in enumerate(headers):
        table.cell(0, i).text = header
    
    # Add the rows to the table
    for row in rows[:7]:  # Only include up to 7 rows as per requirement
        row_cells = table.add_row().cells
        for i, cell_data in enumerate(row):
            row_cells[i].text = cell_data

