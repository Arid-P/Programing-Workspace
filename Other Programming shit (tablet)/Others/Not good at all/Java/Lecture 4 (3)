import java.util.*;

public class Main {
	public static void main(String[] args) {
	Scanner sc = new Scanner(System.in);
	int i;
	do{
	   int m = sc.nextInt();
	     if(m >= 95){
	       System.out.println("This is Very Good");
	     }else if(m >= 85){
	         System.out.println("This is Good");
	     }else if(m >= 75){
	         System.out.println("This is Normal");
	     }else if(m >= 60){
	         System.out.println("This is Average");
	     }else{
	         System.out.println("This is Bad ");
	     };
	     System.out.println("Want to Continue? if yes then type 1 otherwise 0"); 	       
	     i = sc.nextInt();
   	}while (i == 1);
	}
}