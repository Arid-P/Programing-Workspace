import java.util.*;

class Main {
  public static void main(String[] args) {
    System.out.println("please enter the angles");
	  Scanner sc = new Scanner(System.in);
	  float a = sc.nextFloat();
	  float b = sc.nextFloat();
	  float sum = a + b;
    if(sum == 180){
	    System.out.println("They are supplementary angles");
       } else if(sum == 90){
	    System.out.println("They are complementary angles");
       } else {
	    System.out.println("Both of they are neither supplementary nor complementary angles");
       };
  }
}