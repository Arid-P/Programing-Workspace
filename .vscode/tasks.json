{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-python",
      "type": "shell",
      "command": "python",
      "args": ["${file}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "close": false,
        "clear": false
      }
    },
    {
      "label": "run-go",
      "type": "shell",
      "command": "go",
      "args": ["run", "${file}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "close": false,
        "clear": false
      }
    }
  ]
}
